{
    "name":  "seal-web-app",
    "version":  "1.0.0",
    "description":  "A web-based video/audio downloader interface for yt-dlp",
    "main":  "server/index.js",
    "scripts":  {
                    "dev":  "concurrently \"npm run server:dev\" \"npm run client:dev\"",
                    "server:dev":  "nodemon server/index.js",
                    "client:dev":  "cd client \u0026\u0026 npm start",
                    "build":  "cd client \u0026\u0026 npm run build",
                    "start":  "node server/index.js",
                    "install:all":  "npm install \u0026\u0026 cd client \u0026\u0026 npm install",
                    "test":  "echo \"Error: no test specified\" \u0026\u0026 exit 1"
                },
    "keywords":  [
                     "video-downloader",
                     "audio-downloader",
                     "yt-dlp",
                     "youtube",
                     "web-app"
                 ],
    "author":  "Seal Web App",
    "license":  "GPL-3.0",
    "dependencies":  {
                         "express":  "^4.18.2",
                         "cors":  "^2.8.5",
                         "helmet":  "^7.0.0",
                         "morgan":  "^1.10.0",
                         "socket.io":  "^4.7.2",
                         "multer":  "^1.4.5-lts.1",
                         "fs-extra":  "^11.1.1",
                         "path":  "^0.12.7",
                         "child_process":  "^1.0.2"
                     },
    "devDependencies":  {
                            "nodemon":  "^3.0.1",
                            "concurrently":  "^8.2.0"
                        }
}
