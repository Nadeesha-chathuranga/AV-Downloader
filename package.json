{
    "name": "seal-web-app",
    "version": "1.0.0",
    "description": "A web-based video/audio downloader interface for yt-dlp",
    "main": "server/index.js",
    "scripts": {
        "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
        "server:dev": "nodemon server/index.js",
        "client:dev": "cd client && npm run dev",
        "build": "cd client && npm run build",
        "start": "node server/index.js",
        "install:all": "npm install && cd client && npm install",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [
        "video-downloader",
        "audio-downloader",
        "yt-dlp",
        "youtube",
        "web-app"
    ],
    "author": "Seal Web App",
    "license": "GPL-3.0",
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "fs-extra": "^11.3.0",
        "helmet": "^8.0.0",
        "morgan": "^1.10.0",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "nodemon": "^3.1.9"
    }
}
